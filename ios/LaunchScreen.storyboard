                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Debloated TV" textAlignment="center" lineBreakMode="tailTruncation" adjustsFontSizeToFit="YES" minimumScaleFactor="0.8" translatesAutoresizingMaskIntoConstraints="NO" id="launch-name"><rect key="frame" x="30" y="462" width="333" height="34"/><fontDescription key="fontDescription" type="system" weight="semibold" pointSize="28"/><color key="textColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/><nil key="highlightedColor"/></label>
